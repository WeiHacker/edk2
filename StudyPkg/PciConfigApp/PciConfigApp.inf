## @file
#  PciConfigApp - A UEFI Shell application for PCI/PCIe device enumeration.
#
#  This application reads PCI configuration space using direct I/O port
#  access (0xCF8/0xCFC). It supports two modes:
#    1. No arguments: enumerate all PCI/PCIe devices with Vendor ID & Device ID
#    2. B:D:F argument: dump 256-byte config space, detect Type 0/1 and PCI/PCIe
#
#  Copyright (c) 2026, Study. All rights reserved.<BR>
#  SPDX-License-Identifier: BSD-2-Clause-Patent
#
##

[Defines]
  INF_VERSION                    = 1.25
  BASE_NAME                      = PciConfigApp
  FILE_GUID                      = 9B4C3D2E-1F0A-2B3C-4D5E-6F7A8B9C0D1E
  MODULE_TYPE                    = UEFI_APPLICATION
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = ShellCEntryLib

#
# The following information is for reference only and not required by the build tools.
#
#  VALID_ARCHITECTURES           = IA32 X64
#

[Sources]
  PciConfigApp.h
  PciConfigApp.c

[Packages]
  MdePkg/MdePkg.dec
  ShellPkg/ShellPkg.dec
  StudyPkg/StudyPkg.dec

[LibraryClasses]
  BaseLib
  BaseMemoryLib
  DebugLib
  IoLib
  MemoryAllocationLib
  PrintLib
  ShellCEntryLib
  ShellLib
  UefiBootServicesTableLib
  UefiLib
