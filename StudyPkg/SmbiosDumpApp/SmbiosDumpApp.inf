## @file
#  SmbiosDumpApp - SMBIOS Entry Point Structure Viewer.
#
#  Accesses the SMBIOS Entry Point Structure (EPS) via the EFI
#  Configuration Table, walks the SMBIOS structure table, and
#  installs a custom OEM type with programmer-defined data fields.
#
#  Copyright (c) 2026, Study. All rights reserved.<BR>
#  SPDX-License-Identifier: BSD-2-Clause-Patent
#
##
[Defines]
  INF_VERSION          = 0x00010006
  BASE_NAME            = SmbiosDumpApp
  FILE_GUID            = 4B9C0D1E-2F3A-4B5C-6D7E-8F9A0B1C2D3E
  MODULE_TYPE          = UEFI_APPLICATION
  VERSION_STRING       = 1.0
  ENTRY_POINT          = ShellCEntryLib

[Sources]
  SmbiosDumpApp.h
  SmbiosDumpApp.c

[Packages]
  MdePkg/MdePkg.dec
  ShellPkg/ShellPkg.dec
  StudyPkg/StudyPkg.dec

[Protocols]
  gEfiSmbiosProtocolGuid                     ## CONSUMES

[Guids]
  gEfiSmbiosTableGuid                        ## CONSUMES
  gEfiSmbios3TableGuid                       ## CONSUMES

[BuildOptions]
  MSFT:*_*_*_CC_FLAGS = /utf-8

[LibraryClasses]
  BaseLib
  BaseMemoryLib
  DebugLib
  MemoryAllocationLib
  PrintLib
  ShellCEntryLib
  ShellLib
  UefiApplicationEntryPoint
  UefiBootServicesTableLib
  UefiLib
  UefiRuntimeServicesTableLib
