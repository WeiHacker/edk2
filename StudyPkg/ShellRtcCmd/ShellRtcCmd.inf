## @file
#  ShellRtcCmd - A UEFI Shell dynamic command to read RTC time.
#
#  This driver registers the "rtc" dynamic command with the UEFI Shell.
#  It reads the CMOS RTC date and time using direct I/O port access
#  (0x70/0x71), without using UEFI Runtime Services.
#
#  Copyright (c) 2026, Study. All rights reserved.<BR>
#  SPDX-License-Identifier: BSD-2-Clause-Patent
#
##

[Defines]
  INF_VERSION                    = 1.25
  BASE_NAME                      = ShellRtcCmd
  FILE_GUID                      = 8A3B1C2D-4E5F-6A7B-8C9D-0E1F2A3B4C5D
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = ShellRtcCmdEntryPoint
  UNLOAD_IMAGE                   = ShellRtcCmdUnload

#
# The following information is for reference only and not required by the build tools.
#
#  VALID_ARCHITECTURES           = IA32 X64
#

[Sources]
  ShellRtcCmd.h
  ShellRtcCmd.c

[Packages]
  MdePkg/MdePkg.dec
  ShellPkg/ShellPkg.dec
  StudyPkg/StudyPkg.dec

[LibraryClasses]
  BaseLib
  DebugLib
  IoLib
  MemoryAllocationLib
  PrintLib
  ShellLib
  UefiBootServicesTableLib
  UefiDriverEntryPoint
  UefiLib

[Protocols]
  gEfiShellDynamicCommandProtocolGuid  ## ALWAYS_PRODUCED
  gEfiShellProtocolGuid                ## CONSUMES

[Depex]
  gEfiShellProtocolGuid
