## @file
#  MyDriver - A UEFI Driver Model example.
#
#  This module demonstrates the standard UEFI Driver Model by
#  implementing EFI_DRIVER_BINDING_PROTOCOL with Supported(),
#  Start(), and Stop() functions.
#
#  Copyright (c) 2026, Study. All rights reserved.<BR>
#  SPDX-License-Identifier: BSD-2-Clause-Patent
#
##

[Defines]
  INF_VERSION                    = 1.25
  BASE_NAME                      = MyDriver
  MODULE_UNI_FILE                = MyDriver.uni
  FILE_GUID                      = C45A8E9D-5B0A-4F8C-9A2E-3F4D5E6A7B8D
  MODULE_TYPE                    = UEFI_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = StudyMyDriverEntryPoint

#
# The following information is for reference only and not required by the build tools.
#
#  VALID_ARCHITECTURES           = IA32 X64 AARCH64 ARM RISCV64 LOONGARCH64
#
#  DRIVER_BINDING                =  gStudyMyDriverBinding
#  COMPONENT_NAME                =  gStudyMyDriverComponentName
#  COMPONENT_NAME2               =  gStudyMyDriverComponentName2
#

[Sources]
  MyDriver.h
  MyDriver.c

[Packages]
  MdePkg/MdePkg.dec
  StudyPkg/StudyPkg.dec

[LibraryClasses]
  BaseLib
  BaseMemoryLib
  DebugLib
  MemoryAllocationLib
  PcdLib
  UefiBootServicesTableLib
  UefiDriverEntryPoint
  UefiLib

[Protocols]
  gEfiDevicePathProtocolGuid                    ## TO_START
  gStudyMyDriverProtocolGuid                    ## BY_START

[Guids]
  gStudyMyDriverBindingGuid                     ## SOMETIMES_PRODUCES ## MARKER

[Pcd]
  gStudyPkgTokenSpaceGuid.PcdMyDriverMessage    ## CONSUMES

[Depex]
  TRUE
